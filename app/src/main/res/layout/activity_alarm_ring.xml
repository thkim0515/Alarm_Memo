<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_ring"
    android:padding="32dp">

    <ImageView
        android:id="@+id/iconBadge"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="64dp"
        android:background="@drawable/bg_icon_badge"
        android:padding="16dp"
        android:src="@drawable/ic_alarm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/textTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-thin"
        android:textColor="@color/ring_on_background"
        android:textSize="88sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iconBadge"
        tools:text="07:30" />

    <TextView
        android:id="@+id/textMemo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:alpha="0.9"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="@color/ring_on_background"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textTime"
        tools:text="아침 운동" />

    <TextView
        android:id="@+id/textSnoozeRemaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_pill_translucent"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="@color/ring_on_background_muted"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textMemo"
        tools:text="스누즈 1/3" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonSnooze"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:paddingStart="28dp"
        android:paddingTop="12dp"
        android:paddingEnd="28dp"
        android:paddingBottom="12dp"
        android:text="@string/snooze_button"
        android:textAllCaps="false"
        android:textColor="@color/ring_on_background"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_snooze"
        app:iconTint="@color/ring_on_background"
        app:layout_constraintBottom_toTopOf="@id/slideToDismiss"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#66FFFFFF" />

    <FrameLayout
        android:id="@+id/slideToDismiss"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/bg_slide_track"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/slide_to_dismiss"
            android:textColor="@color/ring_on_background" />

        <SeekBar
            android:id="@+id/seekBarDismiss"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progressDrawable="@android:color/transparent"
            android:thumb="@drawable/ic_slide_thumb" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
